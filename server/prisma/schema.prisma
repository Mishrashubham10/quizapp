generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id            Int      @id @default(autoincrement())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())
}

model QuizResult {
  id        Int      @id @default(autoincrement())
  roomId    String
  createdAt DateTime @default(now())

  players PlayerScore[]
}

model PlayerScore {
  id Int @id @default(autoincrement())

  playerName String
  score      Int

  quizResultId Int

  quizResult QuizResult @relation(fields: [quizResultId], references: [id])
}