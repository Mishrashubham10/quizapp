{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*", "test-prisma.ts"],

  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ]
}